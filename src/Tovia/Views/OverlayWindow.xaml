<Window x:Class="Tovia.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tovia.Views"
        xmlns:converters="clr-namespace:Tovia.Converters"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Topmost="True"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="OverlayWindow"
        Height="416"
        Width="320">

    <Border CornerRadius="12"
            BorderThickness="1"
            BorderBrush="white">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#4DFFFFFF"
                              Offset="0.0" />
                <GradientStop Color="#1AFFFFFF"
                              Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        
 
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Drag handle -->
            <Border Grid.Row="0"
                    BorderThickness="0 0 0 0.5"
                    BorderBrush="#33FFFFFF"
                    Cursor="SizeAll"
                    
                    MouseDown="Window_Drag">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0 2 0 0">
                    <Ellipse Width="5"
                             Height="5"
                             Fill="white"
                             Margin="2 0" />
                    <Ellipse Width="5"
                             Height="5"
                             Fill="white"
                             Margin="2 0" />
                    <Ellipse Width="5"
                             Height="5"
                             Fill="white"
                             Margin="2 0" />
                    <Ellipse Width="5"
                             Height="5"
                             Fill="white"
                             Margin="2 0" />
                    <Ellipse Width="5"
                             Height="5"
                             Fill="white"
                             Margin="2 0" />
                    <Ellipse Width="5"
                             Height="5"
                             Fill="white"
                             Margin="2 0" />
                </StackPanel>
            </Border>

            <!-- Task list -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0 4 0 4">
                <ItemsControl ItemsSource="{Binding ToDoList}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource OverlayCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#0B132B"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Row="0"
                                              Grid.Column="1"
                                              Grid.RowSpan="2"
                                              IsChecked="{Binding IsComplete}"
                                              VerticalAlignment="Center"
                                              Margin="6 0 0 0">
                                        
                                    </CheckBox>

                                    <!-- Importance + time left -->
                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Orientation="Horizontal"
                                                Margin="0 4 0 0">
                                        <Border CornerRadius="3"
                                                Padding="4 1"
                                                Margin="0 0 5 0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="#33FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Importance}"
                                                                     Value="High">
                                                            <Setter Property="Background"
                                                                    Value="#338B2A2A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Importance}"
                                                                     Value="Low">
                                                            <Setter Property="Background"
                                                                    Value="#330B132B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Importance}"
                                                       FontSize="9"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="#2A5235" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Importance}"
                                                                         Value="High">
                                                                <Setter Property="Foreground"
                                                                        Value="#6B1A1A" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Importance}"
                                                                         Value="Low">
                                                                <Setter Property="Foreground"
                                                                        Value="#1A2660" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Text="{Binding TimeLeft, StringFormat={}{0:%d}d {0:%h}h {0:%m}m}"
                                                   FontSize="12"
                                                   Foreground="black"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

           

        </Grid>
    </Border>



</Window>
